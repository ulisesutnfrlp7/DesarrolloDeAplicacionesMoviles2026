{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "WebWorker"
    ],
    "strict": true,
    "noEmit": false,
    "outDir": "lib",
    "rootDir": "src",
    "skipLibCheck": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/tests"
  ],
  "extends": "expo/tsconfig.base"
}
